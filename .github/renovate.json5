{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices"
  ],
  "automerge": true,
  "nix": {
    "enabled": true,
    "lockFileMaintenance": {
      "enabled": true,
      "commitMessageAction": "update",
      "commitMessageTopic": "Nix flake lock"
    }
  },
  "packageRules": [
    {
      // The GitHub Actions workflows are managed by Copier, so updating them
      // via Renovate causes conflicts with the Copier template updates.
      "matchManagers": ["github-actions"],
      "enabled": false
    },
    {
      // Except this workflow, which is not managed by Copier.
      "matchManagers": ["github-actions"],
      "matchFileNames": [
        ".github/workflows/rust-continuous-integration.yml"
      ],
      "enabled": true
    }
  ]
}
